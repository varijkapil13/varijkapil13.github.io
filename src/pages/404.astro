---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist or has moved.">
  <section class="container-custom py-24 md:py-32 min-h-[60vh]">
    <p class="pill mb-6"><span class="dot"></span>404</p>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-[-0.035em] mb-4">Page not found</h1>
    <p class="text-lg text-muted mb-8 max-w-lg">This page doesn't exist or has moved.</p>
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Home</a>
      <a href="/blog" class="btn btn-secondary">Writing</a>
    </div>
  </section>
</BaseLayout>
