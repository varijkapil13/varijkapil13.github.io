---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist or has moved.">
  <section class="masthead">
    <div class="container-custom py-20 md:py-28 min-h-[50vh]">
      <h1 class="page-title text-[2.5rem] md:text-[3.5rem]">This stop doesn't exist</h1>
      <p class="text-muted text-lg max-w-[55ch] mt-4">The page may have moved, or the link has a typo. Pick a line from the map or start at the beginning.</p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/blog/series/monolith-to-saas" class="btn btn-secondary">The network map</a>
        <a href="/blog" class="btn btn-secondary">Writing</a>
      </div>
    </div>
  </section>
</BaseLayout>
