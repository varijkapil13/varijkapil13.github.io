---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { readingTime } from "../../utils/readingTime";
import { series, type SeriesId } from "../../data/series";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Series that have at least one published post
const seriesList = (Object.keys(series) as SeriesId[])
  .map((id) => ({ id, ...series[id], count: sortedPosts.filter((p) => p.data.series === id).length }))
  .filter((s) => s.count > 0);

// Filter buttons for tags shared by at least two posts, most used first
const tagCounts = new Map<string, number>();
for (const tag of sortedPosts.flatMap((post) => post.data.tags)) {
  tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const allTags = [...tagCounts]
  .filter(([, count]) => count >= 2)
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag);
---

<BaseLayout title="Blog" description="Notes from running Java backends in production: migrations, Kubernetes, PostgreSQL, CI/CD, and leading platform teams.">
  <section class="border-b border-line">
    <div class="container-custom py-14 md:py-20">
      <p class="eyebrow mb-4">Blog · {sortedPosts.length} posts</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-[-0.035em] mb-4">Writing</h1>
      <p class="text-lg text-muted max-w-2xl">
        Notes from running Java backends in production: migrations, Kubernetes, databases, and the team side of platform work.
      </p>
    </div>
  </section>

  <section class="container-custom py-12">
    {seriesList.map((s) => (
      <a href={`/blog/series/${s.id}`} class="card card-hover p-6 md:p-7 mb-10 flex flex-col md:flex-row md:items-center gap-5 md:gap-10 group">
        <div class="flex-1">
          <p class="eyebrow mb-2"><span class="dot mr-2 align-middle"></span>Series · {s.count} parts</p>
          <h2 class="text-xl font-semibold tracking-tight mb-1.5 group-hover:text-accent transition-colors">{s.title}</h2>
          <p class="text-muted text-sm">{s.description}</p>
        </div>
        <span class="btn btn-secondary shrink-0">Read the series →</span>
      </a>
    ))}

    {allTags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="Filter posts by tag">
        <button type="button" class="tag-filter" data-tag="all" aria-pressed="true">all</button>
        {allTags.map((tag) => (
          <button type="button" class="tag-filter" data-tag={tag} aria-pressed="false">{tag}</button>
        ))}
      </div>
    )}

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {sortedPosts.map((post) => (
        <article class="blog-post card card-hover overflow-hidden group flex flex-col" data-tags={JSON.stringify(post.data.tags)}>
          <a href={`/blog/${post.id}`} class="flex flex-col h-full">
            {post.data.image && (
              <div class="aspect-[1200/630] overflow-hidden border-b border-line">
                <img src={post.data.image} alt="" width="1200" height="630" loading="lazy" class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300" />
              </div>
            )}
            <div class="p-5 flex flex-col flex-1">
              <p class="eyebrow mb-2">
                <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>{" "}
                · {readingTime(post.body)} min
              </p>
              <h2 class="font-semibold leading-snug mb-2 group-hover:text-accent transition-colors">{post.data.title}</h2>
              {post.data.description && <p class="text-sm text-muted line-clamp-2 mb-4">{post.data.description}</p>}
              <p class="eyebrow mt-auto">{post.data.tags.slice(0, 3).join(" · ")}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  @reference "../../styles/global.css";

  .tag-filter {
    @apply font-mono text-xs px-3 py-1.5 rounded-full border border-line text-muted transition-colors;
  }
  .tag-filter:hover {
    @apply text-fg border-line-strong;
  }
  .tag-filter[aria-pressed="true"] {
    @apply bg-fg text-bg border-fg;
  }
</style>

<script>
  const tagButtons = document.querySelectorAll<HTMLButtonElement>(".tag-filter");
  const posts = document.querySelectorAll<HTMLElement>(".blog-post");

  tagButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const tag = button.dataset.tag;
      tagButtons.forEach((btn) => btn.setAttribute("aria-pressed", String(btn === button)));
      posts.forEach((post) => {
        const postTags: string[] = JSON.parse(post.dataset.tags || "[]");
        post.style.display = tag === "all" || postTags.includes(tag!) ? "" : "none";
      });
    });
  });
</script>
