---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { lines } from "../../data/network";
import DepartureBoard from "../../components/DepartureBoard.astro";
import LineBullet from "../../components/LineBullet.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const labels = { date: "Date", line: "Line", post: "Post", read: "Read", minutes: "min" };
---

<BaseLayout title="Blog" description="Notes from running Java backends in production: migrations, Kubernetes, PostgreSQL, CI/CD, and leading platform teams.">
  <section class="masthead">
    <div class="container-custom pt-16 pb-12 md:pt-24 md:pb-16">
      <h1 class="page-title text-[2.5rem] md:text-[3.5rem]">Writing</h1>
      <p class="text-muted text-[17px] leading-relaxed max-w-[62ch] mt-4">
        {sortedPosts.length} posts from running Java backends in production: migrations, Kubernetes, databases, and the team side of platform work. Each one is a station on the <a href="/blog/series/monolith-to-saas" class="text-fg underline underline-offset-4">network map</a>.
      </p>
    </div>
  </section>

  <section>
    <div class="container-custom py-10 md:py-14">
      <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="Filter posts by line">
        <button type="button" class="line-filter" data-line="all" aria-pressed="true">All lines</button>
        {lines.map((line) => (
          <button type="button" class="line-filter" data-line={line.id} aria-pressed="false">
            <LineBullet line={line} /> {line.name.en}
          </button>
        ))}
      </div>
      <div class="panel px-5 sm:px-6">
        <DepartureBoard posts={sortedPosts} labels={labels} descriptions />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @reference "../../styles/global.css";

  .line-filter {
    @apply inline-flex items-center gap-2 h-8 pl-2 pr-3 rounded-full border border-line text-[13px] text-muted transition-colors;
  }
  .line-filter[data-line="all"] {
    @apply pl-3;
  }
  .line-filter:hover {
    @apply text-fg border-line-strong;
  }
  .line-filter[aria-pressed="true"] {
    @apply text-fg border-fg bg-panel;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".line-filter");
  const rows = document.querySelectorAll<HTMLElement>(".board-row");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const line = button.dataset.line;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      rows.forEach((row) => {
        row.hidden = line !== "all" && row.dataset.line !== line;
      });
    });
  });
</script>
