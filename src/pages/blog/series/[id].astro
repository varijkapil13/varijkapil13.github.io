---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { series, type SeriesId } from "../../../data/series";
import { getSeriesPosts } from "../../../utils/series";
import { readingTime } from "../../../utils/readingTime";

export function getStaticPaths() {
  return Object.keys(series).map((id) => ({ params: { id } }));
}

const id = Astro.params.id as SeriesId;
const { title, description } = series[id];
const posts = await getSeriesPosts(id);
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-line">
    <div class="container-custom py-14 md:py-20">
      <a href="/blog" class="eyebrow hover:text-fg transition-colors">← Writing</a>
      <p class="eyebrow mt-8 mb-4"><span class="dot mr-2 align-middle"></span>Series · {posts.length} parts · {posts[0]?.data.date.getFullYear()}–{posts.at(-1)?.data.date.getFullYear()}</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-[-0.035em] leading-[1.08] mb-5 max-w-3xl text-balance">{title}</h1>
      <p class="text-lg text-muted max-w-2xl">{description}</p>
    </div>
  </section>

  <section class="container-custom py-12">
    <ol class="relative max-w-3xl">
      {posts.map((post, i) => (
        <li class="relative pl-14 pb-10 last:pb-0 group">
          {i < posts.length - 1 && <span class="absolute left-[15px] top-9 bottom-0 w-px bg-line" aria-hidden="true"></span>}
          <span class="absolute left-0 top-0 w-8 h-8 rounded-md border border-line bg-panel font-mono text-xs text-accent flex items-center justify-center">
            {String(i + 1).padStart(2, "0")}
          </span>
          <a href={`/blog/${post.id}`} class="block">
            <p class="eyebrow mb-1.5">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long" })}
              </time>{" "}
              · {readingTime(post.body)} min{post.data.seriesLabel && <> · {post.data.seriesLabel}</>}
            </p>
            <h2 class="text-lg font-medium leading-snug group-hover:text-accent transition-colors">{post.data.title}</h2>
            {post.data.description && <p class="text-sm text-muted mt-1.5">{post.data.description}</p>}
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
