---
import Arrow from "../../../components/Arrow.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { series, type SeriesId } from "../../../data/series";
import { lines, text } from "../../../data/network";
import { readingTime } from "../../../utils/readingTime";
import NetworkMap from "../../../components/NetworkMap.astro";
import LineBullet from "../../../components/LineBullet.astro";

export function getStaticPaths() {
  return Object.keys(series).map((id) => ({ params: { id } }));
}

const id = Astro.params.id as SeriesId;
const { title, description } = series[id];
const posts = new Map((await getCollection("blog", ({ data }) => !data.draft)).map((p) => [p.id, p]));
---

<BaseLayout title={title} description={description}>
  <section class="masthead">
    <div class="container-custom pt-16 pb-12 md:pt-24 md:pb-16">
      <a href="/blog" class="text-sm text-muted hover:text-fg transition-colors"><Arrow dir="left" /> Writing</a>
      <h1 class="page-title text-[2.25rem] md:text-[3.25rem] max-w-[20ch] mt-6">{title}</h1>
      <p class="text-muted text-[17px] leading-relaxed max-w-[62ch] mt-5">{description}</p>
    </div>
  </section>

  <section class="container-custom py-12 md:py-16">
    <NetworkMap lang="en" todayLabel="Today" buildingLabel="Still being built" />
  </section>

  <section class="container-custom pb-8 grid gap-12 md:grid-cols-2">
    {lines.map((line) => (
      <div style={`--c: var(--line-${line.id})`}>
        <h2 class="flex items-center gap-2.5 font-semibold tracking-tight text-[18px] pb-3 border-b-2" style="border-color: var(--c)">
          <LineBullet line={line} size="lg" /> {line.name.en} line
        </h2>
        <ol>
          {line.stations.map((station) => {
            const post = station.post ? posts.get(station.post) : undefined;
            return (
              <li class="border-b border-line py-3.5">
                {post ? (
                  <a href={`/blog/${post.id}`} class="block group">
                    <span class="font-medium text-[13px] text-muted">{text(station.label)} · {post.data.date.getFullYear()} · {readingTime(post.body)} min</span>
                    <span class="block font-medium text-[15.5px] leading-snug mt-0.5 group-hover:underline underline-offset-2">{post.data.title}</span>
                  </a>
                ) : (
                  <span class="font-medium text-[13px] text-muted">{text(station.label)}</span>
                )}
              </li>
            );
          })}
          {line.future.map((station) => (
            <li class="border-b border-dashed border-line py-3.5 font-medium text-[13px] text-muted">{text(station.label)} · still being built</li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</BaseLayout>
