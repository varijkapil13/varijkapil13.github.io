---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { readingTime } from "../../utils/readingTime";
import TableOfContents from "../../components/TableOfContents.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import { getSeriesPosts } from "../../utils/series";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const { Content, headings } = await render(post);

const minutes = readingTime(post.body);
const seriesPosts = post.data.series ? await getSeriesPosts(post.data.series) : [];

// Related posts: most shared tags first, then newest
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const sharedTags = (p: CollectionEntry<"blog">) =>
  (p.data.tags ?? []).filter((tag) => post.data.tags?.includes(tag)).length;
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && sharedTags(p) > 0)
  .sort((a, b) => sharedTags(b) - sharedTags(a) || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description || `Read ${post.data.title} on Varij Kapil's blog.`}
  image={post.data.image}
  article={true}
  publishedDate={post.data.date.toISOString()}
  tags={post.data.tags || []}
>
  <article class="container-custom pt-12 md:pt-16 pb-8">
    <a href="/blog" class="eyebrow hover:text-fg transition-colors">← Writing</a>

    <header class="max-w-[760px] mt-8 mb-10">
      <p class="eyebrow mb-4">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </time>{" "}
        · {minutes} min read
      </p>
      <h1 class="text-3xl md:text-[2.75rem] font-semibold tracking-[-0.035em] leading-[1.1] mb-5 text-balance">
        {post.data.title}
      </h1>
      {post.data.description && <p class="text-lg text-muted">{post.data.description}</p>}
      <div class="flex flex-wrap gap-2 mt-6">
        {post.data.tags.map((tag) => <span class="pill">{tag}</span>)}
      </div>
    </header>

    <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,700px)_1fr] gap-12 xl:gap-20 border-t border-line pt-10">
      <div class="min-w-0">
        {post.data.series && (
          <SeriesNav id={post.data.series} posts={seriesPosts} current={post.id} position="top" />
        )}
        <TableOfContents headings={headings} variant="inline" />

        <div class="prose">
          <Content />
        </div>

        {post.data.series && (
          <SeriesNav id={post.data.series} posts={seriesPosts} current={post.id} position="bottom" />
        )}

        <div class="mt-14 pt-6 border-t border-line flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-md bg-fg text-bg font-mono text-xs font-bold flex items-center justify-center" aria-hidden="true">VK</span>
            <div class="text-sm">
              <p class="font-medium">Varij Kapil</p>
              <p class="text-muted">Head of Backend Engineering &amp; Operations</p>
            </div>
          </div>
          <a
            href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(post.data.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            Share on LinkedIn ↗
          </a>
        </div>
      </div>

      <TableOfContents headings={headings} variant="sidebar" />
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="border-t border-line mt-8">
      <div class="container-custom py-12">
        <h2 class="text-xl font-semibold tracking-tight mb-6">Related</h2>
        <ul>
          {relatedPosts.map((relatedPost) => (
            <li class="border-t border-line">
              <a href={`/blog/${relatedPost.id}`} class="grid grid-cols-[1fr_auto] md:grid-cols-[110px_1fr_auto] gap-x-4 gap-y-1 py-4 items-baseline group">
                <time datetime={relatedPost.data.date.toISOString()} class="eyebrow order-2 md:order-none">
                  {relatedPost.data.date.toISOString().slice(0, 10)}
                </time>
                <span class="font-medium col-span-2 md:col-span-1 group-hover:text-accent transition-colors">{relatedPost.data.title}</span>
                <span class="eyebrow text-right order-3 md:order-none">{readingTime(relatedPost.body)} min</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // Copy button on every code block
  document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-code";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy code to clipboard");
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? pre.innerText);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Failed";
      }
      setTimeout(() => (button.textContent = "Copy"), 1500);
    });
    const wrapper = document.createElement("div");
    wrapper.className = "code-block";
    pre.replaceWith(wrapper);
    wrapper.append(pre, button);
  });

  // Link icon on section headings, for sharing a specific section
  document.querySelectorAll<HTMLHeadingElement>(".prose h2[id], .prose h3[id]").forEach((heading) => {
    const link = document.createElement("a");
    link.href = `#${heading.id}`;
    link.className = "heading-anchor";
    link.setAttribute("aria-label", `Link to section: ${heading.textContent}`);
    link.textContent = "#";
    heading.append(link);
  });
</script>
