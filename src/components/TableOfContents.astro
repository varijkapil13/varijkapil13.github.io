---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  // "inline": collapsible box above the post (small screens); "sidebar": sticky strip map (wide screens)
  variant: "inline" | "sidebar";
}

const { headings, variant } = Astro.props;
// Sections are the stops; sub-sections would crowd the strip
const items = headings.filter((h) => h.depth === 2);
---

{items.length >= 3 && variant === "inline" && (
  <details class="lg:hidden border-y-2 border-fg py-3 mb-10">
    <summary class="cursor-pointer font-sign font-bold text-[19px]">On this page · {items.length} sections</summary>
    <ol class="toc-strip mt-4">
      {items.map((h) => (
        <li><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ol>
  </details>
)}

{items.length >= 3 && variant === "sidebar" && (
  <nav aria-label="Table of contents" class="hidden lg:block">
    <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pb-4">
      <p class="font-sign font-bold text-[19px] mb-4">On this page</p>
      <ol class="toc-strip">
        {items.map((h) => (
          <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>
        ))}
      </ol>
    </div>
  </nav>
)}

<style>
  @reference "../styles/global.css";

  /* The post's sections as stops on its line */
  .toc-strip li {
    position: relative;
    padding: 0 0 14px 26px;
    @apply text-[15px] leading-snug;
  }

  .toc-strip li::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 5px;
    background: var(--post-line, var(--fg));
  }

  .toc-strip li:first-child::before { top: 6px; }
  .toc-strip li:last-child::before { bottom: auto; height: 8px; }

  .toc-strip li::after {
    content: "";
    position: absolute;
    left: 7px;
    top: 6px;
    width: 13px;
    height: 4px;
    background: var(--post-line, var(--fg));
  }

  .toc-strip a {
    @apply text-muted hover:text-fg;
  }

  /* You are here */
  .toc-strip li:has(a.is-current)::after {
    left: 1px;
    top: 0;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: var(--bg);
    border: 4px solid var(--fg);
  }

  .toc-strip a.is-current {
    @apply text-fg font-semibold;
  }
</style>

<script>
  // Mark the section currently in view
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
  if (links.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((l) => l.classList.toggle("is-current", l.dataset.tocLink === entry.target.id));
        }
      },
      { rootMargin: "-80px 0px -70% 0px" }
    );
    links.forEach((l) => {
      const target = document.getElementById(l.dataset.tocLink!);
      if (target) observer.observe(target);
    });
  }
</script>
