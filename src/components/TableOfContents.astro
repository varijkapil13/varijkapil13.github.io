---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  // "inline": collapsible box above the post (small screens); "sidebar": sticky column (wide screens)
  variant: "inline" | "sidebar";
}

const { headings, variant } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length >= 3 && variant === "inline" && (
  <details class="lg:hidden card px-5 py-4 mb-10">
    <summary class="cursor-pointer eyebrow">On this page</summary>
    <ol class="mt-3 space-y-1.5 text-sm">
      {items.map((h) => (
        <li class={h.depth === 3 ? "pl-4" : ""}>
          <a href={`#${h.slug}`} class="text-muted hover:text-fg">{h.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

{items.length >= 3 && variant === "sidebar" && (
  <nav aria-label="Table of contents" class="hidden lg:block">
    <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
      <p class="eyebrow mb-3">On this page</p>
      <ol class="space-y-2 text-[13px] border-l border-line">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class:list={[
                "block -ml-px border-l border-transparent text-muted hover:text-fg transition-colors leading-snug",
                h.depth === 3 ? "pl-6" : "pl-3",
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}

<script>
  // Highlight the section currently in view
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
  if (links.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((l) => {
            const active = l.dataset.tocLink === entry.target.id;
            l.classList.toggle("!text-fg", active);
            l.classList.toggle("!border-accent", active);
          });
        }
      },
      { rootMargin: "-80px 0px -70% 0px" }
    );
    links.forEach((l) => {
      const target = document.getElementById(l.dataset.tocLink!);
      if (target) observer.observe(target);
    });
  }
</script>
