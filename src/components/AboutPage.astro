---
import Arrow from "./Arrow.astro";
import { useTranslations } from "../i18n/translations";
import { aboutData, type AboutLang } from "../data/about";
import { skills, splitByUse } from "../data/skills";
import { linkedinUrl } from "../data/social";
import { lines } from "../data/network";
import LineBullet from "./LineBullet.astro";

interface Props {
  lang: AboutLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { experience, education, interests, certifications, projects } = aboutData[lang];

const skillGroups = [
  { key: "languages", title: t("skills.languages") },
  { key: "frameworks", title: t("skills.frameworks") },
  { key: "platform", title: t("skills.platform") },
  { key: "tools", title: t("skills.tools") },
] as const;

// What each line of the network means in my work
const lineText: Record<string, string> = {
  runtime: t("about.platformModDesc"),
  data: t("about.dataDesc"),
  platform: t("about.k8sCloudDesc"),
  operations: t("about.gitopsDesc"),
  security: t("about.securityDesc"),
  team: `${t("about.teamDevDesc")} ${t("about.engineeringDesc")}`,
};
---
<section class="sign">
  <div class="container-custom pt-12 pb-10 md:pt-16 md:pb-14">
    <h1 class="sign-title text-[3.25rem] md:text-[5rem]">{t('about.title')} {t('about.titleHighlight')}</h1>
    <div class="max-w-[62ch] mt-6 space-y-4 text-[17px] sm:text-lg text-sign-muted">
      <p>
        {t('about.intro')} <strong class="text-sign-fg font-semibold">{t('hero.name')}</strong>, Head of Backend Engineering & Operations {t('about.experience')} <strong class="text-sign-fg font-semibold">{t('about.yearsExp')}</strong> {t('about.expText')} <strong class="text-sign-fg font-semibold">{t('about.location')}</strong>{t('about.locationSuffix')}
      </p>
      <p>
        {t('about.description1')} <strong class="text-sign-fg font-semibold">{t('about.multiTenant')}</strong>{t('about.description1Suffix')}
      </p>
      <p>
        {t('about.description2')} <strong class="text-sign-fg font-semibold">{t('about.cloudNative')}</strong>{t('about.description3')} <strong class="text-sign-fg font-semibold">{t('about.kubernetes')}</strong>{t('about.description4')}
      </p>
    </div>
    <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn btn-plate mt-8">{t('home.ctaLinkedIn')} <Arrow /></a>
  </div>
</section>

<div class="container-custom">
  <!-- The lines -->
  <section class="py-14 md:py-16">
    <h2 class="heading mb-6">{t('about.lines')}</h2>
    <ul class="border-t-2 border-fg">
      {lines.map((line) => (
        <li class="grid grid-cols-[2.6rem_minmax(0,1fr)] md:grid-cols-[2.6rem_12rem_minmax(0,1fr)] gap-x-4 gap-y-1 py-4 border-b border-line">
          <LineBullet line={line} size="lg" />
          <h3 class="font-sign font-bold text-[22px] leading-tight self-center">{line.name[lang]}</h3>
          <p class="col-start-2 md:col-start-3 md:row-start-1 text-muted">{lineText[line.id]}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Skills -->
  <section class="pb-14 md:pb-16">
    <h2 class="heading mb-6">{t('about.techSkills')} {t('about.skills')}</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 border-t-2 border-fg">
      {skillGroups.map(({ key, title }) => {
        const { daily, shipped } = splitByUse(skills[key]);
        return (
          <div class="py-5 border-b border-line">
            <h3 class="font-sign font-bold text-[20px] mb-3">{title}</h3>
            <p class="text-sm text-muted">{t('skills.daily')}</p>
            <p class="mb-3">{daily.map((s) => s.name).join(", ")}</p>
            {shipped.length > 0 && (
              <>
                <p class="text-sm text-muted">{t('skills.shipped')}</p>
                <p class="text-muted">{shipped.map((s) => s.name).join(", ")}</p>
              </>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <!-- Career, drawn as a line: the current role is the interchange -->
  <section class="pb-14 md:pb-16">
    <h2 class="heading mb-8">{t('about.career')}</h2>
    <ol class="career">
      {experience.map((job, index) => (
        <li class:list={["career-stop", index === 0 && "is-now"]}>
          <details open={index === 0}>
            <summary class="cursor-pointer list-none">
              <span class="block font-sign font-bold text-[22px] leading-tight">{job.role}</span>
              <span class="block text-muted mt-1">{job.company} · {job.period} · {job.location}</span>
            </summary>
            <div class="mt-3 max-w-[70ch]">
              <p class="mb-3">{job.description}</p>
              <ul class="career-list">
                {job.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </section>

  <!-- Education and certifications -->
  <section class="pb-14 md:pb-16 grid gap-12 md:grid-cols-2">
    <div>
      <h2 class="heading mb-6">{t('about.education')}</h2>
      <ul class="border-t-2 border-fg">
        {education.map((edu) => (
          <li class="py-4 border-b border-line">
            <h3 class="font-semibold text-[18px]">{edu.degree}</h3>
            <p class="text-muted">{edu.school}</p>
            <p class="text-muted text-sm">{edu.period} · {edu.location}</p>
            {edu.thesis && <p class="text-muted text-sm mt-2">{t('about.thesis')}: <em>{edu.thesis}</em></p>}
            {edu.note && <p class="text-muted text-sm mt-1">{edu.note}</p>}
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="heading mb-6">{t('about.certifications')}</h2>
      <ul class="border-t-2 border-fg">
        {certifications.map((cert) => <li class="py-4 border-b border-line font-semibold">{cert}</li>)}
      </ul>
      <h2 class="heading mt-12 mb-6">{t('about.beyondCode')} {t('about.code')}</h2>
      <p class="text-muted">{interests.join(" · ")}</p>
    </div>
  </section>

  <!-- University projects -->
  <section class="pb-8">
    <h2 class="heading mb-6">{t('about.uniProjects')}{t('about.projects')}</h2>
    <ul class="border-t-2 border-fg grid md:grid-cols-2 gap-x-8">
      {projects.map((project) => (
        <li class="py-4 border-b border-line">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <h3 class="font-semibold text-[18px]">{project.name}</h3>
            <span class="text-sm text-muted whitespace-nowrap">{project.period}</span>
          </div>
          <p class="text-sm text-muted">{project.association}</p>
          <p class="mt-2">{project.description}</p>
          <p class="text-sm text-muted mt-2">{project.technologies.join(" · ")}</p>
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  @reference "../styles/global.css";

  .career-stop {
    position: relative;
    padding: 0 0 32px 40px;
  }

  .career-stop::before {
    content: "";
    position: absolute;
    left: 11px;
    top: 0;
    bottom: 0;
    width: 6px;
    background: var(--fg);
  }

  .career-stop:last-child::before {
    bottom: auto;
    height: 14px;
  }

  .career-stop::after {
    content: "";
    position: absolute;
    left: 11px;
    top: 10px;
    width: 18px;
    height: 5px;
    background: var(--fg);
  }

  .career-stop.is-now::before {
    top: 12px;
  }

  .career-stop.is-now::after {
    left: 2px;
    top: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg);
    border: 5px solid var(--fg);
  }

  .career-list li {
    position: relative;
    padding-left: 18px;
    margin: 8px 0;
  }

  .career-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 3px;
    background: var(--muted);
  }
</style>
