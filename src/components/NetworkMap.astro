---
import { getCollection } from "astro:content";
import { lines, hubName, mapColumns, text, type Lang } from "../data/network";
import LineBullet from "./LineBullet.astro";

interface Props {
  lang: Lang;
  todayLabel: string;
  buildingLabel: string;
}

const { lang, todayLabel, buildingLabel } = Astro.props;
const posts = await getCollection("blog", ({ data }) => !data.draft);
const titles = new Map(posts.map((p) => [p.id, p.data.title]));
---

<!-- Wide screens: one row per line, stations right-aligned so every line runs into the interchange -->
<div class="netmap hidden md:block" style={`--cols: ${mapColumns}; --rows: ${lines.length}`}>
  <div class="nm-hub-layer" aria-hidden="true">
    <span class="nm-hub"></span>
    <span class="nm-hub-label"><strong>{todayLabel}</strong> {hubName[lang]}</span>
  </div>
  {lines.map((line) => (
    <div class="nm-row" style={`--c: var(--line-${line.id})`}>
      <p class="nm-name"><LineBullet line={line} /> {line.name[lang]}</p>
      <ol class="nm-track" style={`grid-column: ${mapColumns - line.stations.length + 2} / span ${line.stations.length}`}>
        {line.stations.map((station) => (
          <li class="nm-station">
            {station.post ? (
              <a href={`/blog/${station.post}`} title={titles.get(station.post)}>{text(station.label, lang)}</a>
            ) : (
              <span>{text(station.label, lang)}</span>
            )}
          </li>
        ))}
      </ol>
      <span class:list={["nm-through", line.future.length === 0 && "is-terminus"]} aria-hidden="true"></span>
      {line.future.length > 0 && (
        <ol class="nm-future" aria-label={buildingLabel}>
          {line.future.map((station) => <li class="nm-station"><span>{text(station.label, lang)}</span></li>)}
        </ol>
      )}
    </div>
  ))}
</div>

<!-- Phones and small tablets: each line as a strip map, like the ones above train doors -->
<div class="grid grid-cols-2 gap-x-4 gap-y-7 md:hidden">
  {lines.map((line) => (
    <div style={`--c: var(--line-${line.id})`}>
      <p class="nm-name mb-3"><LineBullet line={line} /> {line.name[lang]}</p>
      <ol class="strip">
        {line.stations.map((station) => (
          <li>
            {station.post ? (
              <a href={`/blog/${station.post}`} title={titles.get(station.post)}>{text(station.label, lang)}</a>
            ) : (
              <span class="text-muted">{text(station.label, lang)}</span>
            )}
          </li>
        ))}
        <li class="strip-hub"><span><strong>{todayLabel}</strong></span></li>
        {line.future.map((station) => (
          <li class="strip-future"><span class="text-muted">{text(station.label, lang)}</span></li>
        ))}
      </ol>
    </div>
  ))}
</div>

<style>
  @reference "../styles/global.css";

  /* Shared column template: line name, the station columns, the interchange, stations still being built */
  .netmap {
    --name: 128px;
    --hub: 40px;
    --future: 168px;
    --row: 62px;
    --rail: 3px;
    --dot: 9px;
    /* distance from a row's top to the centre of its rail */
    --rail-y: calc(var(--row) - 16px);
    position: relative;
  }

  .nm-row,
  .nm-hub-layer {
    display: grid;
    grid-template-columns: var(--name) repeat(var(--cols), minmax(0, 1fr)) var(--hub) var(--future);
  }

  .nm-row {
    height: var(--row);
    position: relative;
    transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Signature interaction: pointing at a line brings it forward */
  .netmap:has(.nm-row:hover, .nm-row:focus-within) .nm-row:not(:hover, :focus-within) {
    opacity: 0.18;
  }

  .nm-name {
    @apply flex items-center gap-2 font-medium text-[13px] leading-none text-fg;
  }

  .netmap .nm-name {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    height: 20px;
    margin-top: calc(var(--rail-y) - 10px);
  }

  .nm-track,
  .nm-future {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    grid-row: 1;
    height: var(--row);
  }

  .nm-future {
    grid-column: calc(var(--cols) + 3);
  }

  .nm-station {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 4px calc(var(--row) - var(--rail-y) + 10px);
    text-align: center;
    @apply text-[12.5px] leading-[1.15];
  }

  .nm-station a {
    @apply text-fg hover:text-accent transition-colors;
  }

  .nm-station span {
    @apply text-muted;
  }

  /* The rail: each station draws the half on either side of its dot */
  .nm-station::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--rail-y) - var(--rail) / 2);
    height: var(--rail);
    background: var(--c);
  }

  .nm-track .nm-station:first-child::before {
    left: 50%;
    border-radius: 2px 0 0 2px;
  }

  /* Station dot */
  .nm-station::after {
    content: "";
    position: absolute;
    left: calc(50% - var(--dot) / 2);
    top: calc(var(--rail-y) - var(--dot) / 2);
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--panel);
    border: 2px solid var(--c);
  }

  .nm-station:has(a)::after {
    background: var(--c);
  }

  .nm-station:has(a:hover)::after,
  .nm-station:has(a:focus-visible)::after {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 25%, transparent);
  }

  /* Rail continuing into the interchange */
  .nm-through {
    grid-column: calc(var(--cols) + 2);
    grid-row: 1;
    position: relative;
  }

  .nm-through::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--rail-y) - var(--rail) / 2);
    height: var(--rail);
    background: var(--c);
  }

  .nm-through.is-terminus::before {
    right: 50%;
  }

  /* Stations still being built: dashed rail, open dot */
  .nm-future .nm-station::before {
    right: 50%;
    background: repeating-linear-gradient(90deg, var(--c) 0 6px, transparent 6px 11px);
    opacity: 0.8;
  }

  .nm-future .nm-station::after {
    background: var(--panel);
  }

  /* The interchange every line runs into */
  .nm-hub-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .nm-hub {
    grid-column: calc(var(--cols) + 2);
    grid-row: 1;
    justify-self: center;
    width: 16px;
    margin-top: calc(var(--rail-y) - 8px);
    height: calc((var(--rows) - 1) * var(--row) + 16px);
    border-radius: 8px;
    background: var(--panel);
    border: 2px solid var(--fg);
  }

  .nm-hub-label {
    grid-column: calc(var(--cols) + 3);
    grid-row: 1;
    align-self: start;
    margin-top: calc(var(--rail-y) - 18px);
    padding-left: 8px;
    @apply text-[12.5px] leading-[1.2] text-muted;
  }

  .nm-hub-label strong {
    @apply block font-semibold text-[14px] text-fg;
  }

  /* Strip maps (phones) */
  .strip li {
    position: relative;
    padding: 0 0 0 22px;
    min-height: 30px;
    @apply text-[14px] leading-[1.2];
  }

  .strip li a {
    @apply text-fg;
  }

  .strip li::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--c);
  }

  .strip li:first-child::before {
    top: 7px;
  }

  .strip li::after {
    content: "";
    position: absolute;
    left: 3px;
    top: 4px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--panel);
    border: 2px solid var(--c);
  }

  .strip li:has(a)::after {
    background: var(--c);
  }

  .strip li.strip-hub::after {
    left: 0;
    top: 1px;
    width: 15px;
    height: 15px;
    border: 2px solid var(--fg);
    background: var(--panel);
  }

  .strip li.strip-hub:last-child::before {
    bottom: auto;
    height: 8px;
  }

  .strip li.strip-future::before {
    background: repeating-linear-gradient(180deg, var(--c) 0 5px, transparent 5px 9px);
    bottom: auto;
    height: 12px;
  }

  .strip li.strip-future::after {
    top: 12px;
  }

  .strip li.strip-future {
    padding-top: 8px;
  }
</style>
