---
import Arrow from "./Arrow.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/translations';
import { linkedinUrl } from '../data/social';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const links = [
  { href: "/blog", label: t('nav.blog') },
  { href: getLocalizedPath("/about", lang), label: t('nav.about') },
  { href: getLocalizedPath("/projects", lang), label: t('nav.projects') },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer class="border-t border-line mt-16">
  <div class="container-custom py-12 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="font-semibold tracking-tight text-[15px]">Varij Kapil</p>
      <p class="text-muted text-sm mt-1">{t('hero.title')} · {t('hero.location')}</p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-6 gap-y-3">
      {links.map((link) => (
        <a href={link.href} class="text-sm text-muted hover:text-fg transition-colors">{link.label}</a>
      ))}
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">LinkedIn <Arrow /></a>
    </nav>
  </div>
  <div class="container-custom pb-8">
    <p class="text-sm text-muted">© {currentYear} Varij Kapil</p>
  </div>
</footer>
