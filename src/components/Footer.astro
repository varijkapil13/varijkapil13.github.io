---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/translations';
import { linkedinUrl } from '../data/social';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const links = [
  { href: "/blog", label: t('nav.blog') },
  { href: getLocalizedPath("/about", lang), label: t('nav.about') },
  { href: getLocalizedPath("/projects", lang), label: t('nav.projects') },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer class="border-t border-line mt-8">
  <div class="container-custom py-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6 text-sm">
    <div>
      <p class="font-medium">Varij Kapil</p>
      <p class="text-muted mt-1">{t('hero.title')} · {t('hero.location')}</p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-muted">
      {links.map((link) => (
        <a href={link.href} class="hover:text-fg transition-colors">{link.label}</a>
      ))}
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-fg hover:text-accent transition-colors">LinkedIn ↗</a>
    </nav>
  </div>
  <div class="container-custom pb-10">
    <p class="eyebrow">© {currentYear} Varij Kapil</p>
  </div>
</footer>
