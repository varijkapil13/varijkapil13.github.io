---
import { skills, splitByUse } from '../data/skills';
import { useTranslations } from '../i18n/translations';

interface Props {
  lang: 'en' | 'de' | 'hi';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const icons: Record<string, string> = {
  languages: `<div class="p-2 rounded-lg bg-primary-50 dark:bg-primary-950">
<svg aria-hidden="true" class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
</svg>
</div>`,
  frameworks: `<div class="p-2 rounded-lg bg-accent-50 dark:bg-accent-950">
<svg aria-hidden="true" class="w-6 h-6 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
</svg>
</div>`,
  platform: `<div class="p-2 rounded-lg bg-green-50 dark:bg-green-950">
<svg aria-hidden="true" class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
</svg>
</div>`,
  tools: `<div class="p-2 rounded-lg bg-orange-50 dark:bg-orange-950">
<svg aria-hidden="true" class="w-6 h-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
</svg>
</div>`,
};

const groups = [
  { key: 'languages', title: t('skills.languages') },
  { key: 'frameworks', title: t('skills.frameworks') },
  { key: 'platform', title: t('skills.platform') },
  { key: 'tools', title: t('skills.tools') },
] as const;
---

<section class="section bg-white dark:bg-slate-900">
  <div class="container-custom">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        {t('skills.title')} <span class="gradient-text">{t('skills.titleHighlight')}</span>
      </h2>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        {t('skills.description')}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {groups.map(({ key, title }) => {
        const { daily, shipped } = splitByUse(skills[key]);
        return (
          <div class="card p-6">
            <div class="flex items-center gap-3 mb-5">
              <Fragment set:html={icons[key]} />
              <h3 class="font-semibold text-lg">{title}</h3>
            </div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">{t('skills.daily')}</p>
            <ul class="flex flex-wrap gap-2 mb-4">
              {daily.map((s) => (
                <li class="px-2.5 py-1 rounded-md bg-primary-50 dark:bg-primary-950 text-primary-700 dark:text-primary-300 text-sm font-medium">{s.name}</li>
              ))}
            </ul>
            {shipped.length > 0 && (
              <>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">{t('skills.shipped')}</p>
                <ul class="flex flex-wrap gap-2">
                  {shipped.map((s) => (
                    <li class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-sm">{s.name}</li>
                  ))}
                </ul>
              </>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
