---
import type { CollectionEntry } from "astro:content";
import { series, type SeriesId } from "../data/series";

interface Props {
  id: SeriesId;
  posts: CollectionEntry<"blog">[];
  current: string;
  position: "top" | "bottom";
}

const { id, posts, current, position } = Astro.props;
const index = posts.findIndex((p) => p.id === current);
const prev = posts[index - 1];
const next = posts[index + 1];
const href = `/blog/series/${id}`;
---

{position === "top" ? (
  <details data-series-nav class="card px-5 py-4 mb-10">
    <summary class="cursor-pointer">
      <span class="eyebrow"><span class="text-accent">{String(index + 1).padStart(2, "0")}/{String(posts.length).padStart(2, "0")}</span> · Series</span>{" "}
      <a href={href} class="font-medium hover:text-accent">{series[id].title}</a>
    </summary>
    <ol class="mt-4 space-y-1.5 text-sm list-decimal pl-6 marker:font-mono marker:text-muted">
      {posts.map((p) => (
        <li>
          {p.id === current ? (
            <span class="font-medium text-fg" aria-current="page">{p.data.title}</span>
          ) : (
            <a href={`/blog/${p.id}`} class="text-muted hover:text-fg">{p.data.title}</a>
          )}
        </li>
      ))}
    </ol>
  </details>
) : (
  <nav aria-label="Series navigation" class="mt-12 grid sm:grid-cols-2 gap-4">
    {prev ? (
      <a href={`/blog/${prev.id}`} class="card card-hover p-5 group">
        <span class="eyebrow">Previous in series</span>
        <span class="block mt-1.5 font-medium leading-snug group-hover:text-accent transition-colors">{prev.data.title}</span>
      </a>
    ) : <div class="hidden sm:block"></div>}
    {next ? (
      <a href={`/blog/${next.id}`} class="card card-hover p-5 group sm:text-right">
        <span class="eyebrow">Next in series</span>
        <span class="block mt-1.5 font-medium leading-snug group-hover:text-accent transition-colors">{next.data.title}</span>
      </a>
    ) : (
      <a href={href} class="card card-hover p-5 group sm:text-right">
        <span class="eyebrow">End of series</span>
        <span class="block mt-1.5 font-medium leading-snug group-hover:text-accent transition-colors">See all {posts.length} parts</span>
      </a>
    )}
  </nav>
)}
