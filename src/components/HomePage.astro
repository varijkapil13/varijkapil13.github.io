---
import Arrow from "./Arrow.astro";
import { getCollection } from "astro:content";
import { useTranslations, getLocalizedPath } from "../i18n/translations";
import { linkedinUrl } from "../data/social";
import NetworkMap from "./NetworkMap.astro";
import DepartureBoard from "./DepartureBoard.astro";

interface Props {
  lang: "en" | "de" | "hi";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

const facts = [t("hero.location"), t("home.fact.experienceValue"), t("home.fact.teamValue")];
const boardLabels = {
  date: t("home.board.date"),
  line: t("home.board.line"),
  post: t("home.board.post"),
  read: t("home.board.read"),
  minutes: t("home.minutes"),
};
---

<!-- Who and what -->
<section class="masthead">
  <div class="container-custom pt-20 pb-16 md:pt-28 md:pb-20">
    <h1 class="page-title text-[2.75rem] sm:text-[3.75rem] md:text-[4.5rem]">{t("hero.name")}</h1>
    <p class="text-[20px] sm:text-[24px] font-medium tracking-[-0.02em] text-muted mt-3">{t("hero.title")}</p>
    <p class="lead max-w-[58ch] mt-6">{t("home.lead")}</p>
    <ul class="flex flex-wrap gap-x-2 gap-y-1 mt-4 text-sm text-muted">
      {facts.map((fact, i) => <li>{i > 0 && <span aria-hidden="true" class="mr-2 text-line-strong">/</span>}{fact}</li>)}
    </ul>
    <div class="flex flex-wrap gap-3 mt-9">
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        {t("home.ctaLinkedIn")} <Arrow />
      </a>
      <a href="/blog" class="btn btn-secondary">{t("home.ctaWriting")}</a>
    </div>
  </div>
</section>

<!-- The network -->
<section class="container-custom pt-16 md:pt-20">
  <h2 class="heading">{t("home.network")}</h2>
  <p class="lead max-w-[65ch] mt-2 mb-8">{t("home.networkLead")}</p>
  <div class="panel map-ground p-5 sm:p-7 md:px-8 md:pt-4 md:pb-8">
    <NetworkMap lang={lang} todayLabel={t("home.today")} />
  </div>
</section>

<!-- Latest writing -->
<section class="container-custom pt-16 md:pt-20">
  <div class="flex flex-wrap items-baseline justify-between gap-4 mb-5">
    <h2 class="heading">{t("home.latest")}</h2>
    <a href="/blog" class="text-sm text-muted hover:text-fg transition-colors">{t("home.allPosts")} ({allPosts.length}) <Arrow /></a>
  </div>
  {t("blog.englishOnly") && <p class="text-muted text-sm mb-4">{t("blog.englishOnly")}</p>}
  <div class="panel px-5 sm:px-6">
    <DepartureBoard posts={latestPosts} labels={boardLabels} />
  </div>
</section>

<!-- Close -->
<section class="container-custom py-16 md:py-20">
  <div class="panel p-8 md:p-10 grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
    <div>
      <h2 class="heading">{t("home.closing")}</h2>
      <p class="lead max-w-[60ch] mt-2">{t("home.closingText")}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t("home.ctaLinkedIn")} <Arrow /></a>
      <a href={getLocalizedPath("/about", lang)} class="btn btn-secondary">{t("nav.about")}</a>
    </div>
  </div>
</section>
