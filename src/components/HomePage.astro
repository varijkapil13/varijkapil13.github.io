---
import Arrow from "./Arrow.astro";
import { getCollection } from "astro:content";
import { useTranslations, getLocalizedPath } from "../i18n/translations";
import { linkedinUrl } from "../data/social";
import NetworkMap from "./NetworkMap.astro";
import DepartureBoard from "./DepartureBoard.astro";

interface Props {
  lang: "en" | "de" | "hi";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

const facts = [t("hero.location"), t("home.fact.experienceValue"), t("home.fact.teamValue")];
const boardLabels = {
  date: t("home.board.date"),
  line: t("home.board.line"),
  post: t("home.board.post"),
  read: t("home.board.read"),
  minutes: t("home.minutes"),
};
---

<!-- Station sign: who and what -->
<section class="sign">
  <div class="container-custom pt-10 pb-9 md:pt-14 md:pb-10">
    <h1 class="sign-title text-[3.5rem] sm:text-[5rem] md:text-[6rem]">{t("hero.name")}</h1>
    <div class="grid gap-7 md:grid-cols-[minmax(0,1fr)_auto] md:items-end mt-3">
      <div>
        <p class="font-sign font-semibold text-[22px] sm:text-[28px] leading-tight">{t("hero.title")}</p>
        <p class="text-sign-muted text-[17px] sm:text-lg max-w-[60ch] mt-3">{t("home.lead")}</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-1 mt-3 font-sign font-semibold text-[18px] text-sign-muted">
          {facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href="/blog" class="btn border-2 border-sign-fg/60 text-sign-fg hover:border-sign-fg md:order-first">{t("home.ctaWriting")}</a>
        <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn btn-plate order-first md:order-none">
          {t("home.ctaLinkedIn")} <Arrow />
        </a>
      </div>
    </div>
  </div>
</section>

<!-- The network -->
<section class="container-custom pt-8 pb-14 md:pt-9 md:pb-20">
  <div class="grid gap-x-10 gap-y-2 md:grid-cols-[auto_minmax(0,1fr)] md:items-baseline mb-6 md:mb-2">
    <h2 class="heading">{t("home.network")}</h2>
    <p class="text-muted max-w-[70ch]">{t("home.networkLead")}</p>
  </div>
  <NetworkMap lang={lang} todayLabel={t("home.today")} buildingLabel={t("home.building")} />
</section>

<!-- Departures: latest writing -->
<section class="bg-board text-board-fg">
  <div class="container-custom py-14 md:py-16">
    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-6">
      <h2 class="heading">{t("home.latest")}</h2>
      <a href="/blog" class="font-sign font-bold text-[19px] underline underline-offset-4 decoration-2">{t("home.allPosts")} ({allPosts.length}) <Arrow /></a>
    </div>
    {t("blog.englishOnly") && <p class="text-board-muted mb-6">{t("blog.englishOnly")}</p>}
    <DepartureBoard posts={latestPosts} labels={boardLabels} />
  </div>
</section>

<!-- Close -->
<section class="container-custom py-16 md:py-20 grid gap-6 md:grid-cols-[1fr_auto] md:items-end">
  <div>
    <h2 class="heading">{t("home.closing")}</h2>
    <p class="text-muted text-[17px] max-w-[60ch] mt-3">{t("home.closingText")}</p>
  </div>
  <div class="flex flex-wrap gap-3">
    <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t("home.ctaLinkedIn")} <Arrow /></a>
    <a href={getLocalizedPath("/about", lang)} class="btn btn-secondary">{t("nav.about")}</a>
  </div>
</section>
