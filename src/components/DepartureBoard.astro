---
import type { CollectionEntry } from "astro:content";
import { findStation, text } from "../data/network";
import { readingTime } from "../utils/readingTime";
import LineBullet from "./LineBullet.astro";
import Arrow from "./Arrow.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
  labels: { date: string; line: string; post: string; read: string; minutes: string };
  // Show each post's description under its title (the full list on /blog)
  descriptions?: boolean;
}

const { posts, labels, descriptions = false } = Astro.props;
---

<div class="board-head" aria-hidden="true">
  <span>{labels.date}</span>
  <span>{labels.line}</span>
  <span>{labels.post}</span>
  <span class="text-right">{labels.read}</span>
</div>
<ul class="board-rows">
  {posts.map((post, i) => {
    const at = findStation(post.id);
    return (
      <li class="board-row" data-line={at?.line.id} style={`--i: ${Math.min(i, 8)}; view-transition-name: row-${post.id}`}>
        <a href={`/blog/${post.id}`} class="board-link group">
          <time datetime={post.data.date.toISOString()} class="board-date">{post.data.date.toISOString().slice(0, 10)}</time>
          <span class="board-line">
            {at && <LineBullet line={at.line} />}
            <span class="sr-only">{at && `${at.line.name.en} line, ${text(at.station.label)}`}</span>
          </span>
          <span class="board-title">
            <span class="font-medium text-[15.5px] leading-snug transition-colors" style={`view-transition-name: post-${post.id}`}>{post.data.title}</span>
            <span class="board-arrow" aria-hidden="true"><Arrow /></span>
            {descriptions && post.data.description && <span class="block text-[14px] text-muted mt-1 leading-snug">{post.data.description}</span>}
          </span>
          <span class="board-read">{readingTime(post.body)} {labels.minutes}</span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  @reference "../styles/global.css";

  .board-head,
  .board-link {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr) auto;
    column-gap: 0.85rem;
  }

  .board-head {
    @apply hidden md:grid font-mono text-[11.5px] text-muted pt-4 pb-3 border-b border-line;
  }

  .board-link {
    @apply py-4 items-baseline;
    grid-template-areas: "line title title" "line date read";
    row-gap: 0.2rem;
  }

  .board-row + .board-row {
    border-top: 1px solid var(--line);
  }

  .board-link {
    @apply -mx-3 px-3 rounded-[8px] transition-colors duration-150;
  }

  .board-link:hover {
    background: color-mix(in srgb, var(--fg) 3.5%, transparent);
  }

  .board-link:hover .board-title > span:first-child {
    @apply text-accent;
  }

  /* An arrow slides in beside the title on hover: this row is a way in */
  .board-arrow {
    @apply inline-block ml-1.5 text-accent text-[13px] opacity-0;
    transform: translateX(-4px);
    transition: opacity 150ms ease-out, transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .board-link:hover .board-arrow,
  .board-link:focus-visible .board-arrow {
    opacity: 1;
    transform: none;
  }

  /* The list arrives once, as a list: rows rise in order, capped at the ninth */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .board-rows:not(.is-in) .board-row {
      opacity: 0;
      transform: translateY(6px);
    }

    .board-rows.is-in .board-row {
      transition: opacity 360ms ease-out calc(var(--i) * 40ms), transform 480ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 40ms);
    }
  }

  .board-date { grid-area: date; @apply font-mono text-[12.5px] text-muted; }
  .board-line { grid-area: line; align-self: start; padding-top: 2px; }
  .board-title { grid-area: title; min-width: 0; }
  .board-read { grid-area: read; @apply font-mono text-[12.5px] text-muted text-right whitespace-nowrap; }

  @media (min-width: 768px) {
    .board-head,
    .board-link {
      grid-template-columns: 6.5rem 2rem minmax(0, 1fr) 4.5rem;
      grid-template-areas: "date line title read";
    }
  }
</style>

<script>
  const lists = document.querySelectorAll<HTMLElement>(".board-rows");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.15 }
    );
    lists.forEach((l) => observer.observe(l));
  } else {
    lists.forEach((l) => l.classList.add("is-in"));
  }
</script>
